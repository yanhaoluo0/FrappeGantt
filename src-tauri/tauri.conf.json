{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "时序任务管理",
  "version": "0.1.0",
  "identifier": "com.local.taskmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "时序任务管理",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#06131a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "本机项目时序与进度管理",
    "longDescription": "面向本机任务计划的时序、依赖关系与进度管理工具。",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
